<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LAB_BACKUP_DIR</key>
		<string>PASTE_BACKUP_DIR</string>
	</dict>
	<key>Label</key>
	<string>com.homelab.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homelab-backup/lab-backup</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/var/log/homelab/backup.err</string>
	<key>StandardOutPath</key>
	<string>/var/log/homelab/backup.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>2</integer>
		<key>Minute</key>
		<integer>47</integer>
	</dict>
	<key>UserName</key>
	<string>lab</string>
	<key>WorkingDirectory</key>
	<string>/opt/homelab</string>
</dict>
</plist>
